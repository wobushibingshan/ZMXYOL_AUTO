{
    "启动游戏": {
        "action": {
            "type": "StartApp",
            "param": {
                "package": "com.tencent.tmgp.zmxyol"
            }
        },
        "post_delay": 5000,
        "focus": {
            "Node.Action.Succeeded": {
                "content": "已发送启动游戏指令，等待进入村庄",
                "display": "toast"
            }
        },
        "next": [
            "启动游戏_处理界面"
        ]
    },
